function Step1(){
  const {inst,setInst,curricular,setCurricular,sel,setSel,cfg,setCfg,setStep} = useApp();
  const [q,setQ] = useState('');const [showJson,setShowJson] = useState(!curricular);const [err,setErr] = useState('');
  const onJson = async (e)=>{setErr('');const f = e.target.files?.[0];if(!f)return;
    try{const t = await f.text();const d = JSON.parse(t);
      if(!d.criterios||!d.objetivos) throw new Error('Estructura inválida');
      setCurricular(d);setShowJson(false);
    }catch(e){setErr('Error: '+e.message);}};
  const all = useMemo(()=>{if(!curricular)return[];
    return curricular.criterios.flatMap(c=>c.destrezas_con_criterios_de_desempeno.map(d=>({...d,criterio:c.codigo,indicadores:c.indicadores_evaluacion})));},[curricular]);
  const filtered = useMemo(()=>{if(!q)return all.slice(0,20);
    return all.filter(d=>d.codigo.toLowerCase().includes(q.toLowerCase())||d.descripcion.toLowerCase().includes(q.toLowerCase()));},[all,q]);
  const selD = useMemo(()=>all.filter(d=>sel.destrezaCodigos.includes(d.codigo)),[all,sel]);
  const periodos = selD.length*inst.periodosPorDestreza;

  const toggle = (c)=>{const n = sel.destrezaCodigos.includes(c)?sel.destrezaCodigos.filter(x=>x!==c):[...sel.destrezaCodigos,c];setSel({...sel,destrezaCodigos:n});};
  const distribuir = ()=>{if(!inst.fechaInicio||!inst.fechaFin||!selD.length)return alert('Faltan fechas o DCD');
    const ini = new Date(inst.fechaInicio), fin = new Date(inst.fechaFin);
    const dias = Math.round((fin-ini)/86400000);const sem = Math.max(1,Math.ceil(dias/7));
    const porSem = Math.ceil(selD.length/sem);const fases = ['Anticipación','Construcción','Consolidación'];
    const out = [];let cur = 0;
    for(let s=0;s<sem;s++){const ch = selD.slice(cur,cur+porSem);if(!ch.length)break;
      const d1 = new Date(ini);d1.setDate(d1.getDate()+s*7);
      const d2 = new Date(d1);d2.setDate(d2.getDate()+4);
      out.push({semana:s+1,fechaInicio:d1.toISOString().slice(0,10),fechaFin:d2.toISOString().slice(0,10),fase:fases[s%3],contenido:ch.map(x=>x.codigo).join(', ')});
      cur += porSem;}
    out.push({semana:out.length+1,fechaInicio:out.length?out[out.length-1].fechaFin:inst.fechaInicio,fechaFin:inst.fechaFin,fase:'Evaluación sumativa',contenido:'Rúbrica analítica'});
    setCfg({...cfg,distribucionSemanal:out});};

  return <div>
    <div className="card"><div className="card-head"><span>🏫 {inst.nombreInstitucion} · {inst.anioLectivo}</span></div>
      <small className="muted">Se toma de Configuración. No hace falta escribirlo.</small></div>
