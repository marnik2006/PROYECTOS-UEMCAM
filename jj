        <div style={{display:'flex',justifyContent:'space-between'}}>
          <div className="plan-icon" style={{background:PLAN_TYPES[p.planType].color+'20',color:PLAN_TYPES[p.planType].color}}>{PLAN_TYPES[p.planType].icon}</div>
          <div className="tags"><span className="tag">{p.planType}</span><span className="tag green">{p.sel.destrezaCodigos.length} DCD</span></div>
        </div>
        <div><b style={{fontSize:14}}>{p.nombre}</b>
          <div className="muted tiny" style={{marginTop:4}}>{p.curricular.asignatura} · {p.inst.gradoCurso}</div>
          <div className="muted tiny">{new Date(p.fechaCreacion).toLocaleDateString('es-EC')} · {p.cfg.parcial||''}</div>
        </div>
        <div className="biblio-actions">
          <button onClick={()=>loadPlan(p.id)}>👁 Abrir</button>
          <button onClick={()=>dupPlan(p.id)}>📋 Duplicar</button>
          <button className="danger" onClick={()=>confirm('¿Eliminar?')&&deletePlanning(p.id)}>🗑 Eliminar</button>
        </div>
      </div>)}
    </div>
  </div>;
}

function Config(){
  const {inst,setInst,setView,showToast} = useApp();
  const [tab,setTab] = useState('general');
  const up = (k,v)=>setInst({...inst,[k]:v});
  const onLogo = async (key,e)=>{const f = e.target.files?.[0];if(!f)return;up(key,await toDataUrl(f));};
  return <div style={{flex:1,display:'flex',flexDirection:'column'}}>
    <div className="header-bar"><div className="header-title"><div className="header-icon">🏫</div><div><h1>Configuración Institucional</h1><small>Aparece en todos los documentos</small></div></div>
      <div style={{display:'flex',gap:8}}>
        <button className="btn-ghost" style={{background:'rgba(255,255,255,.15)',color:'#fff',border:'none'}} onClick={()=>setView('dashboard')}>← Volver</button>
        <button className="btn-primary" onClick={()=>showToast('✅ Guardado automáticamente')}>💾 Guardar</button>
      </div></div>
    <div className="tabs">{['general','autoridades','logos','periodo'].map(t=><button key={t} className={`tab ${tab===t?'active':''}`} onClick={()=>setTab(t)}>{t.charAt(0).toUpperCase()+t.slice(1)}</button>)}</div>
    <div style={{padding:20,maxWidth:1000,margin:'0 auto',width:'100%'}}>
      {tab==='general' && <div className="card"><div className="card-head">🏛️ Datos de la institución</div>
        <div className="form-grid" style={{marginTop:12}}>
          <label>Nombre<input value={inst.nombreInstitucion} onChange={e=>up('nombreInstitucion',e.target.value)}/></label>
          <label>AMIE<input value={inst.codigoAmie} onChange={e=>up('codigoAmie',e.target.value)}/></label>
          <label>Zona<input value={inst.zona} onChange={e=>up('zona',e.target.value)}/></label>
          <label>Distrito<input value={inst.distrito} onChange={e=>up('distrito',e.target.value)}/></label>
          <label>Circuito<input value={inst.circuito} onChange={e=>up('circuito',e.target.value)}/></label>
          <label>Teléfono<input value={inst.telefono} onChange={e=>up('telefono',e.target.value)}/></label>
          <label className="full">Dirección<input value={inst.direccion} onChange={e=>up('direccion',e.target.value)}/></label>
        </div></div>}
      {tab==='autoridades' && <div className="card"><div className="card-head">👤 Autoridades</div>
        <div className="form-grid" style={{marginTop:12}}>
          <label>Docente tutor<input value={inst.docente} onChange={e=>up('docente',e.target.value)}/></label>
          <label>Rector/a<input value={inst.rector} onChange={e=>up('rector',e.target.value)}/></label>
          <label>Vicerrector/a<input value={inst.vicerrector} onChange={e=>up('vicerrector',e.target.value)}/></label>
          <label>Secretario/a<input value={inst.secretario} onChange={e=>up('secretario',e.target.value)}/></label>
          <label>Inspector/a<input value={inst.inspector} onChange={e=>up('inspector',e.target.value)}/></label>
          <label>Tutor/a<input value={inst.tutorCurso} onChange={e=>up('tutorCurso',e.target.value)}/></label>
        </div></div>}
      {tab==='logos' && <div className="card"><div className="card-head">🖼️ Logos institucionales</div>
        <div className="logo-grid" style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:16,marginTop:12}}>
          <div><b>Logo izquierdo</b>
            <label className="drop-zone" style={{marginTop:8,minHeight:150}}>
              <input type="file" accept="image/*" hidden onChange={e=>onLogo('logoIzq',e)}/>
              {inst.logoIzq?<img src={inst.logoIzq} style={{maxWidth:'100%',maxHeight:130}}/>:<><div style={{fontSize:32}}>📤</div><small>Subir</small></>}
            </label>
            {inst.logoIzq && <button className="link-btn" onClick={()=>up('logoIzq','')}>Quitar</button>}
          </div>
          <div><b>Logo derecho (Ministerio)</b>
            <label className="drop-zone" style={{marginTop:8,minHeight:150}}>
              <input type="file" accept="image/*" hidden onChange={e=>onLogo('logoDer',e)}/>
              {inst.logoDer?<img src={inst.logoDer} style={{maxWidth:'100%',maxHeight:130}}/>:<><div style={{fontSize:32}}>📤</div><small>Subir</small></>}
            </label>
            {inst.logoDer && <button className="link-btn" onClick={()=>up('logoDer','')}>Quitar</button>}
          </div>
        </div></div>}
      {tab==='periodo' && <div className="card"><div className="card-head">📅 Período académico</div>
        <div className="form-grid" style={{marginTop:12}}>
          <label>Año lectivo<input value={inst.anioLectivo} onChange={e=>up('anioLectivo',e.target.value)}/></label>
          <label>Jornada<select value={inst.jornada} onChange={e=>up('jornada',e.target.value)}><option>Matutina</option><option>Vespertina</option><option>Nocturna</option><option>Completa</option></select></label>
          <label>Curso<input value={inst.gradoCurso} onChange={e=>up('gradoCurso',e.target.value)}/></label>
          <label>Paralelos<input value={inst.paralelos} onChange={e=>up('paralelos',e.target.value)}/></label>
          <label>Períodos/DCD<input type="number" value={inst.periodosPorDestreza} onChange={e=>up('periodosPorDestreza',+e.target.value)}/></label>
          <label>Fecha inicio<input type="date" value={inst.fechaInicio} onChange={e=>up('fechaInicio',e.target.value)}/></label>
          <label>Fecha fin<input type="date" value={inst.fechaFin} onChange={e=>up('fechaFin',e.target.value)}/></label>
        </div></div>}
    </div>
  </div>;
}

function Respaldo(){
  const {exportBackup,importBackup,clearAll,setView,saved} = useApp();
  const fileRef = useRef(null);
  return <div style={{flex:1,display:'flex',flexDirection:'column'}}>
    <div className="header-bar"><div className="header-title"><div className="header-icon">💾</div><div><h1>Respaldo y fábrica</h1><small>Autoguardado activo en este dispositivo</small></div></div>
      <button className="btn-ghost" style={{background:'rgba(255,255,255,.15)',color:'#fff',border:'none'}} onClick={()=>setView('dashboard')}>← Volver</button></div>
    <div style={{padding:20,maxWidth:800,margin:'0 auto',width:'100%'}}>
      <div className="card">
        <div className="card-head">📦 Exportar respaldo</div>
        <p className="muted">Descarga un archivo JSON con todas tus planificaciones, institución, DCD, fórmulas y configuraciones.</p>
        <button className="btn-primary" style={{marginTop:12}} onClick={exportBackup}>⬇️ Exportar respaldo ({saved.length} planes)</button>
      </div>
      <div className="card" style={{marginTop:14}}>
        <div className="card-head">⬆️ Restaurar respaldo</div>
        <p className="muted">Selecciona un archivo JSON exportado previamente.</p>
        <input ref={fileRef} type="file" accept=".json" style={{display:'none'}} onChange={async e=>{const f = e.target.files?.[0];if(f){await importBackup(f);fileRef.current.value='';}}}/>
        <button className="btn-ghost" style={{marginTop:12}} onClick={()=>fileRef.current?.click()}>Seleccionar archivo</button>
      </div>
      <div className="card" style={{marginTop:14,borderColor:'#fecaca'}}>
        <div className="card-head" style={{color:'#991b1b'}}>🧨 Reiniciar a valores de fábrica</div>
        <p className="muted">Elimina TODO lo guardado en este dispositivo. No se puede deshacer.</p>
        <button className="btn-primary" style={{background:'#dc2626',marginTop:12}} onClick={clearAll}>Reiniciar sistema</button>
      </div>
    </div>
  </div>;
}

function App(){
  const {view,planType,toast} = useApp();
  const render = ()=>{
    if(view==='wizard') return planType?<Wizard/>:<Dashboard/>;
    if(view==='biblioteca') return <Biblioteca/>;
    if(view==='config') return <Config/>;
    if(view==='respaldo') return <Respaldo/>;
    return <Dashboard/>;
  };
  return <div className="app">
    <Sidebar/>
    <main className="main">
      {render()}
      <div className="footer">Planificador Microcurricular DUA 3.0 · Elaborado por: MSc. Marco Perugachi Salazar</div>
    </main>
    {view==='dashboard' && !planType && <NewPlanModal/>}
    {toast && <div className="toast">{toast}</div>}
  </div>;
}

ReactDOM.createRoot(document.getElementById('root')).render(<AppProvider><App/></AppProvider>);
</script>
</body>
</html>