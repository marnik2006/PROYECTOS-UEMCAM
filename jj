    <div className="card"><div className="card-head"><span>📥 JSON Curricular</span>
      {curricular && <button className="link-btn" onClick={()=>setShowJson(!showJson)}>{showJson?'Ver DCD':'Cambiar JSON'}</button>}</div>
      {showJson && <>
        <label className="drop-zone"><input type="file" accept=".json" hidden onChange={onJson}/>
          <div style={{fontSize:40}}>📄</div><b>Sube el JSON curricular (MinEduc)</b>
          <small>Formato: asignatura, nivel, objetivos, criterios, DCD, indicadores</small></label>
        {curricular && <div style={{background:'#f0fdf4',border:'1px solid #bbf7d0',padding:'10px 12px',borderRadius:8,fontSize:12.5,marginTop:8,color:'#166534'}}>
          <b>{curricular.asignatura}</b> — {curricular.nivel} · {curricular.objetivos.length} objetivos · {curricular.criterios.length} criterios</div>}
        {err && <div style={{background:'#fee2e2',color:'#991b1b',padding:8,borderRadius:8,marginTop:8,fontSize:12.5}}>{err}</div>}
      </>}
    </div>
    {curricular && !showJson && <>
      <div className="card"><div className="card-head"><span>🎯 Destrezas (DCD)</span></div>
        <small className="muted">Busca y selecciona</small>
        <div className="search-dcd" style={{marginTop:8}}><span>🔍</span><input placeholder="Buscar (código, contenido...)" value={q} onChange={e=>setQ(e.target.value)}/></div>
        <div className="dcd-list">
          {filtered.map(d=><div key={d.codigo} className={`dcd-card ${sel.destrezaCodigos.includes(d.codigo)?'selected':''}`} onClick={()=>toggle(d.codigo)}>
