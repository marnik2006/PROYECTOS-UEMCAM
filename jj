  const [cfg,setCfg] = useState(DEF_CFG);
  const [nee,setNee] = useState([]);
  const [icons,setIcons] = useState({competencias:{},inserciones:{}});
  const [prompt,setPrompt] = useState('');
  const [sigs,setSigs] = useState(DEF_SIGS);
  const [saved,setSaved] = useState([]);
  const [toast,setToast] = useState('');

  useEffect(()=>{try{const r = localStorage.getItem(STORAGE); if(r){const d = JSON.parse(r);
    d.inst&&setInst(d.inst); d.curricular&&setCurricular(d.curricular); d.sel&&setSel(d.sel);
    d.cfg&&setCfg(d.cfg); d.nee&&setNee(d.nee); d.icons&&setIcons(d.icons);
    d.prompt&&setPrompt(d.prompt); d.sigs&&setSigs(d.sigs); d.saved&&setSaved(d.saved);
  }}catch(e){}},[]);
  useEffect(()=>{localStorage.setItem(STORAGE,JSON.stringify({inst,curricular,sel,cfg,nee,icons,prompt,sigs,saved}))},[inst,curricular,sel,cfg,nee,icons,prompt,sigs,saved]);

  const showToast = (m)=>{setToast(m);setTimeout(()=>setToast(''),2200);};
  const resetWizard = ()=>{setPlanType(null);setStep(1);setSel({objetivoCodigos:[],criterioCodigos:[],destrezaCodigos:[],indicadorCodigos:[]});setCfg(DEF_CFG);setNee([]);setPrompt('');};
  const savePlanning = (p)=>{setSaved(prev=>[p,...prev.filter(x=>x.id!==p.id)]);showToast('✅ Guardado en biblioteca');};
  const deletePlanning = (id)=>setSaved(prev=>prev.filter(x=>x.id!==id));
  const loadPlan = (id)=>{const p = saved.find(s=>s.id===id);if(!p)return;
    setInst(p.inst);setCurricular(p.curricular);setSel(p.sel);setCfg(p.cfg);setNee(p.nee);
    setSigs(p.sigs);setPlanType(p.planType);setStep(3);setView('wizard');};
  const dupPlan = (id)=>{const p = saved.find(s=>s.id===id);if(!p)return;
    savePlanning({...p,id:uid(),nombre:p.nombre+' (copia)',fechaCreacion:new Date().toISOString()});};
  const clearAll = ()=>{if(!confirm('⚠️ Se eliminará TODO. ¿Continuar?'))return;
    localStorage.removeItem(STORAGE);
    setInst(DEF_INST);setCurricular(null);setSel({objetivoCodigos:[],criterioCodigos:[],destrezaCodigos:[],indicadorCodigos:[]});
    setCfg(DEF_CFG);setNee([]);setIcons({competencias:{},inserciones:{}});setPrompt('');setSigs(DEF_SIGS);setSaved([]);setPlanType(null);setStep(1);setView('dashboard');};
  const exportBackup = ()=>{const payload = {v:1,at:new Date().toISOString(),data:{inst,curricular,sel,cfg,nee,icons,prompt,sigs,saved}};
    dlBlob(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}),`respaldo_${new Date().toISOString().slice(0,10)}.json`);};
  const importBackup = async (f)=>{const t = await f.text();const p = JSON.parse(t);const d = p.data||p;
    d.inst&&setInst(d.inst);d.curricular&&setCurricular(d.curricular);d.sel&&setSel(d.sel);d.cfg&&setCfg(d.cfg);
    d.nee&&setNee(d.nee);d.icons&&setIcons(d.icons);d.prompt&&setPrompt(d.prompt);d.sigs&&setSigs(d.sigs);d.saved&&setSaved(d.saved);
    showToast('✅ Respaldo restaurado');};

  return <ctx.Provider value={{view,setView,planType,setPlanType,step,setStep,inst,setInst,curricular,setCurricular,sel,setSel,cfg,setCfg,nee,setNee,icons,setIcons,prompt,setPrompt,sigs,setSigs,saved,savePlanning,deletePlanning,loadPlan,dupPlan,clearAll,exportBackup,importBackup,resetWizard,toast,showToast}}>
    {children}
  </ctx.Provider>;
}

