  const copyPrompt = async ()=>{try{await navigator.clipboard.writeText(prompt);alert('📋 Copiado. Pega en ChatGPT y trae la respuesta.');}catch{}};
  const aplicar = ()=>{
    try{const clean = pasteTxt.replace(/^```json\s*/,'').replace(/^```\s*/,'').replace(/```$/,'');
      const data = JSON.parse(clean);
      if(data.phases){const newPhases = cfg.phases.map(p=>{const f = data.phases.find(x=>x.key===p.key);return f?{...p,actividades:(f.actividades||[]).map(a=>({id:uid(),texto:a.texto||a,emojis:a.emojis}))}:p;});setCfg({...cfg,phases:newPhases,respuestaAI:pasteTxt});}
      if(data.formulas){setCfg(prev=>({...prev,formulas:(prev.formulas||[]).concat(data.formulas.map(f=>({id:uid(),...f})))}));}
      setPasteOpen(false);alert('✅ Respuesta aplicada');
    }catch(e){alert('Error al parsear: '+e.message);}};

  const addAct = (pi)=>{const p = [...cfg.phases];p[pi].actividades = [...p[pi].actividades,{id:uid(),texto:''}];setCfg({...cfg,phases:p});};
  const updAct = (pi,ai,t)=>{const p = [...cfg.phases];p[pi].actividades[ai].texto = t;setCfg({...cfg,phases:p});};
  const delAct = (pi,ai)=>{const p = [...cfg.phases];p[pi].actividades.splice(ai,1);setCfg({...cfg,phases:p});};

  return <div>
    <div className="card"><div className="card-head"><span>⚡ La planificación en un minuto</span></div>
      <small className="muted">Escribe cómo la quieres, copia las indicaciones y pídele a ChatGPT que traiga la respuesta completa.</small>
      <textarea className="indicaciones" style={{marginTop:8}} placeholder="¿Cómo quieres tu planificación? (opcional)" value={cfg.instruccionesAdicionales} onChange={e=>setCfg({...cfg,instruccionesAdicionales:e.target.value})}/>
      <div className="quick-chips">{['Contexto de la comunidad','Trabajo en grupos','Material concreto','Sin internet','Proyecto','Evaluación formativa','Interculturalidad'].map(c=>
        <button key={c} className="quick-chip" onClick={()=>setCfg({...cfg,instruccionesAdicionales:cfg.instruccionesAdicionales+(cfg.instruccionesAdicionales?' · ':'')+c})}>+ {c}</button>)}</div>
      <div className="prompt-actions">
        <button className="btn-ghost" onClick={copyPrompt}>📋 1 · Copiar indicaciones</button>
        <button className="btn-primary" onClick={()=>setPasteOpen(true)}>📥 2 · Pegar respuesta</button>
      </div>
    </div>

    <div className="card"><div className="card-head"><span>🔬 Metodología</span></div>
      <div className="meth-grid">{METS.map(m=><div key={m} className={`meth-card ${cfg.metodologia===m?'active':''}`} onClick={()=>setCfg({...cfg,metodologia:m})}>
        <div className="meth-title">{m}</div></div>)}</div>
    </div>

    <div className="card"><div className="card-head"><span>📝 Actividades por fase</span></div>
      {cfg.phases.map((p,pi)=><div key={p.key} className="phase-block">
        <div className="phase-head"><div className={`phase-letter ${p.key}`}>{p.label[0]}</div>
          <div style={{flex:1}}><b>{p.label}</b><div className="tiny muted">{p.desc}</div></div></div>
        <div className="phase-activities">
          {p.actividades.length===0 && <div className="tiny muted">Sin actividades. Agrega o pega la respuesta de la IA.</div>}
          {p.actividades.map((a,ai)=><div key={a.id} className="activity-row">
            <div className="activity-num">{ai+1}</div>
            <input value={a.texto} onChange={e=>updAct(pi,ai,e.target.value)} placeholder={`Actividad ${ai+1}...`}/>
            <button className="icon-btn-sm" onClick={()=>delAct(pi,ai)}>✕</button>
          </div>)}
          <button className="link-btn" onClick={()=>addAct(pi)}>+ Agregar actividad</button>
        </div>
      </div>)}
    </div>

    <div className="card"><div className="card-head"><span>∑ Fórmulas LaTeX</span></div>
      <FormulaEditor/>
    </div>

    <button className="btn-primary" style={{width:'100%',justifyContent:'center',padding:14,marginTop:12}} onClick={()=>setStep(3)}>Siguiente: revisar y generar →</button>

    {pasteOpen && <div className="modal-overlay" onClick={()=>setPasteOpen(false)}>
      <div className="modal" onClick={e=>e.stopPropagation()}>
        <h3>Pegar la respuesta de la IA</h3>
        <p className="muted tiny">Pega el JSON que devolvió ChatGPT/Gemini/Claude.</p>
        <textarea rows={10} style={{width:'100%',padding:10,borderRadius:8,border:'1px solid #e2e8f0',fontFamily:'monospace',fontSize:12}} value={pasteTxt} onChange={e=>setPasteTxt(e.target.value)} placeholder='{"phases":[...], "formulas":[...]}'/>
        <div className="actions"><button className="btn-ghost" onClick={()=>setPasteOpen(false)}>Cancelar</button>
          <button className="btn-primary" onClick={aplicar}>Aplicar</button></div>
      </div>
    </div>}
  </div>;
}

function FormulaEditor(){
  const {cfg,setCfg} = useApp();
  const [latex,setLatex] = useState('');const [desc,setDesc] = useState('');
  const [sub,setSub] = useState('C1');const [act,setAct] = useState('A toda la fase');
  const previewRef = useRef(null);

  useEffect(()=>{if(previewRef.current && latex){try{katex.render(latex,previewRef.current,{throwOnError:false,displayMode:true});}catch{}}},[latex]);

  const add = ()=>{if(!latex.trim())return;
    setCfg({...cfg,formulas:[...cfg.formulas,{id:uid(),latex,descripcion:desc,subtema:sub,actividad:act}]});
    setLatex('');setDesc('');};
  const del = (id)=>setCfg({...cfg,formulas:cfg.formulas.filter(f=>f.id!==id)});

  return <div>
    {cfg.formulas.map(f=><div key={f.id} className="formula-row">
      <div className="formula-render" ref={el=>{if(el)try{katex.render(f.latex,el,{throwOnError:false,displayMode:true});}catch{}}}/>
      <div className="formula-fields">
        <input value={f.descripcion||''} onChange={e=>setCfg({...cfg,formulas:cfg.formulas.map(x=>x.id===f.id?{...x,descripcion:e.target.value}:x)})} placeholder="Descripción"/>
        <small className="muted">{f.subtema} · {f.actividad}</small>
      </div>
      <button className="icon-btn-sm" onClick={()=>del(f.id)}>✕</button>
    </div>)}
    <div className="formula-new">
      <input value={latex} onChange={e=>setLatex(e.target.value)} placeholder="Fórmula LaTeX. Ej: v = \frac{d}{t}  ·  E_k = \frac{1}{2} m v^2"/>
      {latex && <div className="preview-box" ref={previewRef}/>}
      <div className="formula-new-row">
        <input value={desc} onChange={e=>setDesc(e.target.value)} placeholder="Descripción"/>
        <select value={sub} onChange={e=>setSub(e.target.value)}>{Array.from({length:cfg.subtemas},(_,i)=><option key={i} value={`C${i+1}`}>C{i+1}</option>)}<option value="Todos">Todos</option></select>
        <button className="btn-primary" onClick={add}>Agregar</button>
      </div>
    </div>
  </div>;
}

function Step3(){
  const {planType,inst,curricular,sel,cfg,nee,sigs,setSigs,setView,setSaved,setStep} = useApp();
  const [showSig,setShowSig] = useState(false);
  const [preview,setPreview] = useState(null);

  const save = ()=>{
    const p = {id:uid(),planType,nombre:`${cfg.unidad} · ${curricular.asignatura}`,fechaCreacion:new Date().toISOString(),inst,curricular,sel,cfg,nee,sigs};
    setSaved(prev=>[p,...prev.filter(x=>x.id!==p.id)]);
    alert('✅ Guardado en biblioteca');
    setView('dashboard');
  };

  const genPDF = async (withSigs)=>{
    const {jsPDF} = window.jspdf;
    const doc = new jsPDF({unit:'mm',format:'a4'});
    const W = 210, M = 12; let y = 12;
    const np = (n=12)=>{if(y+n>285){doc.addPage();y=15;}};

    // Encabezado
    if(inst.logoIzq){try{doc.addImage(inst.logoIzq,'PNG',M,y,22,22);}catch{}}
    if(inst.logoDer){try{doc.addImage(inst.logoDer,'PNG',W-M-22,y,22,22);}catch{}}
    doc.setFont('helvetica','normal');doc.setFontSize(8);
    doc.text('REPÚBLICA DEL ECUADOR · MINISTERIO DE EDUCACIÓN',W/2,y+3,{align:'center'});
    doc.setFont('helvetica','bold');doc.setFontSize(13);
    doc.text(inst.nombreInstitucion||'UNIDAD EDUCATIVA',W/2,y+10,{align:'center'});
    doc.setFont('helvetica','normal');doc.setFontSize(7);
    doc.text(`AMIE: ${inst.codigoAmie} · ${inst.zona} · ${inst.distrito} · ${inst.circuito}`,W/2,y+15,{align:'center'});
    doc.text(`${inst.direccion}`,W/2,y+19,{align:'center'});
    doc.text(`Tel. ${inst.telefono}`,W/2,y+23,{align:'center'});
    y += 28;
    doc.setDrawColor(30,58,138);doc.setLineWidth(.6);doc.line(M,y,W-M,y);y+=6;
    doc.setFont('helvetica','bold');doc.setFontSize(13);
    doc.text('PLANIFICACIÓN MICROCURRICULAR',W/2,y,{align:'center'});y+=8;

    // Datos
    doc.setFontSize(8);
    const rows = [
      ['DOCENTE:',inst.docente||'—','ASIGNATURA:',curricular.asignatura,'CURSO:',inst.gradoCurso],
      ['AÑO LECTIVO:',inst.anioLectivo,'RECTOR/A:',inst.rector||'—','PARALELO:',inst.paralelos||'—'],
      ['NIVEL:',curricular.nivel,'UNIDAD:',cfg.unidad,'PERÍODO:',`${inst.fechaInicio||'—'} al ${inst.fechaFin||'—'}`],
      ['METODOLOGÍA:',cfg.metodologia,'EJE TRANSVERSAL:',(cfg.inserciones||[]).join(', ')||'—']
    ];
    rows.forEach(r=>{np(6);doc.setFont('helvetica','normal');doc.text(r[0],M,y);
      doc.setFont('helvetica','bold');doc.text(String(r[1]).slice(0,45),M+22,y);
      doc.setFont('helvetica','normal');doc.text(r[2],M+75,y);
      doc.setFont('helvetica','bold');doc.text(String(r[3]).slice(0,60),M+100,y);
      if(r[4]){doc.setFont('helvetica','normal');doc.text(r[4],M+165,y);
        doc.setFont('helvetica','bold');doc.text(String(r[5]||''),M+185,y);}
      y+=4.5;});
    y+=3;

    // Tabla de unidades
    np(30);
    doc.setFont('helvetica','bold');doc.setFontSize(10);
    doc.text('PLANIFICACIÓN POR UNIDADES DE APRENDIZAJE',W/2,y,{align:'center'});y+=4;
    const dests = curricular.criterios.flatMap(c=>c.destrezas_con_criterios_de_desempeno.filter(d=>sel.destrezaCodigos.includes(d.codigo)).map(d=>({...d,indicadores:c.indicadores_evaluacion})));
    const numSub = cfg.subtemas||Math.max(1,dests.length);
    const body = [];
    for(let i=0;i<numSub;i++){
      const d = dests[i%dests.length]||{codigo:'—',descripcion:'—',indicadores:[]};
      const s = cfg.distribucionSemanal[i]||{fechaInicio:'—',fechaFin:'—'};
      body.push([`C${i+1}. ${d.descripcion.slice(0,55)}...\nSem ${i+1} · ${s.fechaInicio} al ${s.fechaFin}`,
        `[${d.codigo}] ${d.descripcion}`,
        `Alcanzar destreza ${d.codigo}: ${d.descripcion.slice(0,80)}...`,
        (d.indicadores||[]).map(x=>`${x.codigo}: ${x.descripcion.slice(0,80)}`).join('\n'),
        '1 sem.']);
    }
    doc.autoTable({head:[['Círculo de conocimiento','Saberes','Objetivo','Dominios a lograrse','Tiempo']],body,startY:y,theme:'grid',
      styles:{fontSize:6.5,cellPadding:1.5,overflow:'linebreak'},headStyles:{fillColor:[30,58,138],textColor:255,fontSize:7},
      columnStyles:{0:{cellWidth:32},1:{cellWidth:45},2:{cellWidth:42},3:{cellWidth:55},4:{cellWidth:12}},margin:{left:M,right:M}});
    y = doc.lastAutoTable.finalY+5;

    // Técnicas
    np(20);doc.setFontSize(7);doc.setFont('helvetica','bold');doc.text('Técnicas de evaluación:',M,y);
    doc.setFont('helvetica','normal');doc.text('observación directa, experimentación, resolución de problemas, diálogo socrático, trabajo cooperativo, autoevaluación',M+32,y,{maxWidth:W-M-34});y+=4;
    doc.setFont('helvetica','bold');doc.text('Instrumentos:',M,y);doc.setFont('helvetica','normal');
    doc.text('lista de cotejo, guía de observación, ficha de experimentación, rúbrica',M+22,y,{maxWidth:W-M-24});y+=8;

    // Inserciones
    if((cfg.inserciones||[]).length){np(30);doc.setFont('helvetica','bold');doc.setFontSize(10);
      doc.text('INSERCIONES CURRICULARES',W/2,y,{align:'center'});y+=4;
      doc.autoTable({head:[['Inserción','Propósito']],body:cfg.inserciones.map(i=>[i,'Integración transversal en el desarrollo de la unidad']),
        startY:y,theme:'grid',styles:{fontSize:7,cellPadding:2},headStyles:{fillColor:[30,58,138],textColor:255},margin:{left:M,right:M}});
      y = doc.lastAutoTable.finalY+6;}

    // Detalle por subtema
    for(let i=0;i<numSub;i++){
      np(40);const d = dests[i%dests.length]||{codigo:'—',descripcion:'—'};
      doc.setFont('helvetica','bold');doc.setFontSize(9);
      doc.text(`C${i+1} - ${d.codigo}: ${d.descripcion.slice(0,100)}`,M,y);y+=5;
      cfg.phases.forEach(p=>{np(15);doc.setFont('helvetica','bold');doc.setFontSize(8);doc.text(p.label,M,y);y+=4;
        doc.setFont('helvetica','normal');doc.setFontSize(7);
        p.actividades.forEach((a,ai)=>{const lines = doc.splitTextToSize(`${ai+1}. ${a.texto}${a.emojis?'  '+a.emojis:''}`,W-2*M-4);
          lines.forEach(l=>{np();doc.text(l,M+4,y);y+=3.6;});});y+=2;});
      // Fórmulas
      const forms = cfg.formulas.filter(f=>f.subtema===`C${i+1}`||f.subtema==='Todos');
      if(forms.length){np(15);doc.setFont('helvetica','bold');doc.text('Fórmulas y modelos:',M,y);y+=4;
        doc.setFont('helvetica','normal');
        forms.forEach(f=>{doc.text(`• ${f.descripcion||''}: ${f.latex}`,M+4,y);y+=3.5;});}
    }

    // NEE
    if(nee.length){np(30);doc.setFont('helvetica','bold');doc.setFontSize(10);
      doc.text('ADAPTACIONES NEE',W/2,y,{align:'center'});y+=4;
      doc.autoTable({head:[['Estudiante','Grado','Estrategia']],body:nee.map(n=>[n.nombre,n.grado,n.estrategia]),
        startY:y,theme:'grid',styles:{fontSize:7,cellPadding:1.5},headStyles:{fillColor:[30,58,138],textColor:255},margin:{left:M,right:M}});
      y = doc.lastAutoTable.finalY+6;}

    // Firmas
    np(50);
    const activas = withSigs.filter(s=>s.activo);
    doc.setFont('helvetica','bold');doc.setFontSize(9);
    doc.text('LEGALIZACIÓN',W/2,y,{align:'center'});y+=10;
    const colW = (W-2*M)/Math.max(1,Math.min(3,activas.length));
    activas.slice(0,3).forEach((s,i)=>{const x = M+i*colW+colW/2;
      doc.line(x-colW/2+8,y,x+colW/2-8,y);
      doc.setFont('helvetica','normal');doc.setFontSize(7);
      doc.text(s.nombre||'—',x,y+4,{align:'center'});
      doc.setFont('helvetica','bold');doc.text(s.rol,x,y+8,{align:'center'});});
    y+=20;doc.setFontSize(7);doc.setFont('helvetica','normal');
    doc.text(`Fecha: ${new Date().toISOString().slice(0,10)}`,M,y);
    doc.setFontSize(6);
    doc.text(`${inst.nombreInstitucion} — Docente: ${inst.docente||'—'}`,W/2,292,{align:'center'});
    doc.text('Elaborado por: MSc. Marco Perugachi Salazar',W/2,295,{align:'center'});

    return doc.output('blob');
  };

  const exportPDF = async ()=>{
    const blob = await genPDF(sigs);
    const url = URL.createObjectURL(blob);
    setPreview(url);
  };

  const exportExcel = ()=>{
    const wb = XLSX.utils.book_new();
    const datos = [['PLANIFICACIÓN MICROCURRICULAR'],['Institución',inst.nombreInstitucion],['Docente',inst.docente],
      ['Asignatura',curricular.asignatura],['Curso',inst.gradoCurso],['Unidad',cfg.unidad],['Metodología',cfg.metodologia]];
    XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(datos),'Datos');
    const dests = [['Código','Descripción','Indicador']];
    curricular.criterios.forEach(c=>c.destrezas_con_criterios_de_desempeno.filter(d=>sel.destrezaCodigos.includes(d.codigo)).forEach(d=>{
      dests.push([d.codigo,d.descripcion,c.indicadores_evaluacion.map(i=>i.codigo).join(', ')]);}));
    XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(dests),'Destrezas');
    const met = [['Fase','Actividad']];
    cfg.phases.forEach(p=>p.actividades.forEach(a=>met.push([p.label,a.texto])));
    XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(met),'Metodología');
    XLSX.writeFile(wb,`Planificacion_${cfg.unidad}_${Date.now()}.xlsx`);
  };

  return <div>
    <div className="review-card">
      <div className="card-head"><span>📄 PLANIFICACIÓN MICROCURRICULAR</span></div>
      <div className="review-grid">
        <div><b>Institución:</b> {inst.nombreInstitucion}</div>
        <div><b>Docente:</b> {inst.docente||'—'}</div>
        <div><b>Asignatura:</b> {curricular.asignatura}</div>
        <div><b>Curso:</b> {inst.gradoCurso} {inst.paralelos && `"${inst.paralelos}"`}</div>
        <div><b>Año:</b> {inst.anioLectivo}</div>
        <div><b>Unidad:</b> {cfg.unidad}</div>
        <div><b>Metodología:</b> {cfg.metodologia}</div>
        <div><b>Fases:</b> {cfg.phases.map(p=>p.label).join(' → ')}</div>
        <div><b>Actividades:</b> {cfg.phases.reduce((a,p)=>a+p.actividades.length,0)} planificadas</div>
        <div><b>DCD:</b> {sel.destrezaCodigos.length}</div>
        <div><b>Fórmulas:</b> {cfg.formulas.length}</div>
        <div><b>NEE:</b> {nee.length===0?'Ninguna':`${nee.length} estudiante(s)`}</div>
        <div className="full"><b>Inserciones:</b> {cfg.inserciones.join(', ')||'—'}</div>
      </div>
    </div>

    <div className="export-grid">
      <button className="export-card purple" onClick={save}>💾<b>Guardar plan</b><small>Queda en tu biblioteca</small></button>
      <button className="export-card red" onClick={exportPDF}>📄<b>Exportar PDF</b><small>Con membrete institucional</small></button>
      <button className="export-card green" onClick={exportExcel}>📊<b>Exportar Excel</b><small>Hojas: datos, metodología, destrezas</small></button>
      <button className="export-card gray" onClick={()=>setShowSig(true)}>✍️<b>Firmas del documento</b><small>Elige autoridades firmantes</small></button>
    </div>

    {showSig && <div className="modal-overlay" onClick={()=>setShowSig(false)}>
      <div className="modal" onClick={e=>e.stopPropagation()}>
        <h3>✍️ ¿Quién firma el documento?</h3>
        <p className="muted tiny">Marca quién firma y edita los nombres.</p>
        {sigs.map((s,i)=><div key={s.rol} style={{display:'flex',alignItems:'center',gap:10,padding:10,border:'1px solid #e2e8f0',borderRadius:10,marginBottom:6,background:s.activo?'#f0fdf4':'#fff'}}>
          <input type="checkbox" checked={s.activo} onChange={()=>setSigs(sigs.map((x,j)=>j===i?{...x,activo:!x.activo}:x))}/>
          <div style={{flex:1}}><b>{s.rol}</b>{s.activo && <input style={{width:'100%',padding:6,border:'1px solid #e2e8f0',borderRadius:6,marginTop:4,fontSize:12}} value={s.nombre} onChange={e=>setSigs(sigs.map((x,j)=>j===i?{...x,nombre:e.target.value}:x))} placeholder={`Nombre del ${s.rol}`}/>}</div>
        </div>)}
        <div className="actions"><button className="btn-ghost" onClick={()=>setShowSig(false)}>Cerrar</button>
          <button className="btn-primary" onClick={()=>{setShowSig(false);exportPDF();}}>🖨️ Generar PDF</button></div>
      </div>
    </div>}

    {preview && <div className="modal-overlay" onClick={()=>{URL.revokeObjectURL(preview);setPreview(null);}}>
      <div className="modal" style={{maxWidth:'95vw',width:'95vw',height:'95vh',display:'flex',flexDirection:'column',padding:12}} onClick={e=>e.stopPropagation()}>
        <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:8}}>
          <b>Vista previa del PDF</b>
          <div style={{display:'flex',gap:8}}>
            <button className="btn-ghost" onClick={()=>{const a = document.createElement('a');a.href=preview;a.download=`Planificacion_${cfg.unidad}.pdf`;a.click();}}>⬇️ Descargar</button>
            <button className="btn-ghost" onClick={()=>{URL.revokeObjectURL(preview);setPreview(null);}}>Cerrar ✕</button>
          </div>
        </div>
        <iframe src={preview} style={{flex:1,width:'100%',border:'1px solid #e2e8f0',borderRadius:8,background:'#fff'}}/>
      </div>
    </div>}
  </div>;
}

